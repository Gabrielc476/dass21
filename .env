# Configurações Gerais
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True

# Segurança
SECRET_KEY=chave-super-secreta-mudar-em-producao
JWT_SECRET_KEY=jwt-chave-secreta-mudar-em-producao

# Banco de Dados
DATABASE_URL=sqlite:///app/dev.sqlite
# Para PostgreSQL em produção, use algo como:
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/dass21_db

# Configurações OCR
UPLOAD_FOLDER=app/uploads
MAX_CONTENT_LENGTH=16777216  # 16MB em bytes
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# Configurações de Tempo (em segundos)
JWT_ACCESS_TOKEN_EXPIRES=3600  # 1 hora

# Configurações CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000